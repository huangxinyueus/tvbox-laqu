<script type="text/javascript">
(function () {
	var root = document.documentElement;
	var isDarkMode = false;
		
	function init() {
    // 判断用户是否是自定义模式
    if (localStorage.getItem('cusDarkMode') === "true" && localStorage.getItem('useDarkMode') !== null) {
        // 用户手动设置了暗色模式
        isDarkMode = localStorage.getItem('useDarkMode') === "true";
    } else {
        // 跟随系统模式或时间
        isDarkMode = window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (!isDarkMode) {
            const now = new Date();
            const hour = now.getHours();
            isDarkMode = hour >= 18 || hour < 7;
        }
        // 更新 useDarkMode 的值
        localStorage.setItem('useDarkMode', isDarkMode);
    }

    if (isDarkMode) {
        applyTheme('dark');
    } else {
        applyTheme('light');
    }
	updateIcon();
	}
init();

	function applyTheme(theme) {
		if (theme === "dark") {
			root.classList.add("dark-mode");
		} else {
			root.classList.remove("dark-mode");
		}

		//localStorage.setItem(storageKey, theme);

		// 同步评论 iframe 暗黑模式
		var iframe = document.getElementById("parentframe");
		if (iframe && iframe.contentWindow) {
			iframe.contentWindow.postMessage({
				type: "theme",
				theme: theme
			}, "*");
		}
		updateIcon();
	}

	function bindToggle() {
		var toggleButton = document.getElementById("theme-toggle");
		if (!toggleButton) {
			return;
		}

		toggleButton.addEventListener("click", function (event) {
			event.preventDefault();

    if (localStorage.getItem("cusDarkMode")!=='true') {
          // 切换到亮色
          localStorage.setItem('cusDarkMode', 'true');
		  localStorage.setItem('useDarkMode', 'false'); 
		  applyTheme('light');
        } else if (localStorage.getItem("useDarkMode")==='false') {
          // 切换到暗色
          localStorage.setItem('cusDarkMode', 'true');
		  localStorage.setItem('useDarkMode', 'true'); 
		  applyTheme('dark');
        } else {
          // 切换到自动
          localStorage.setItem('cusDarkMode', 'false');
		  init();
		  }
		});
		updateIcon();
	}

function updateIcon(){

    var btn = document.getElementById('theme-toggle');

    if (!btn) return;

    var icon = btn.querySelector('i');

    if (!icon) return;


    var cus = localStorage.getItem("cusDarkMode") === "true";
    var use = localStorage.getItem("useDarkMode") === "true";


    var mode;


    if (!cus) {

        // 自动模式
        mode = "auto";

    } else if (use) {

        // 手动暗色
        mode = "dark";

    } else {

        // 手动亮色
        mode = "light";

    }



    icon.className =
        mode === "dark"
        ? "fa fa-moon-o"
        : mode === "light"
        ? "fa fa-sun-o"
        : "fa fa-adjust";


    btn.title =
        mode === "dark"
        ? "当前：暗黑模式"
        : mode === "light"
        ? "当前：浅色模式"
        : "当前：自动模式";

}
	
	//applyTheme(mode);

	if (document.readyState === "loading") {
		document.addEventListener("DOMContentLoaded", bindToggle);
	} else {
		bindToggle();
	}
})();
</script>

